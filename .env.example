NOTION_TOKEN=
NOTION_CASES_DATABASE_ID=
OPENAI_API_KEY=
TRANSLATION_MODEL=gpt-6.1-sol
# Optional: false disables the local admin. Production is always blocked.
TRANSLATION_ADMIN_ENABLED=true
# Optional password for the existing local session endpoint; never enables production.
TRANSLATION_ADMIN_TOKEN=
# Optional for local sync; the scheduler endpoint is blocked in production.
CRON_SECRET=
# Lead form on the service pages (lib/leads.ts). RESEND_API_KEY sends each lead by e-mail;
# LEADS_FROM needs a domain verified in Resend (without it, Resend's test sender only
# delivers to the account owner); LEADS_TO defaults to the Contato page e-mail.
RESEND_API_KEY=
LEADS_FROM=
LEADS_TO=
# Salary survey database (lib/supabase.ts). Use the project URL and Secret / Service Role key
# (server-only; never expose the secret key with NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
